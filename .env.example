# Default is offline. Set AI_MODE=local-embeddings for real CPU semantic retrieval.
PAYPAL_MODE=mock
AI_MODE=offline
PORT=3186
# For sandbox only. Never use production credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
# Real inference using a locally running Ollama model; no paid calls.
OLLAMA_MODEL=
# Keep default local Ollama URL; model must already be installed.
OLLAMA_URL=http://127.0.0.1:11434
